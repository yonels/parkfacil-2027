NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
PARKFACIL_INTERNAL_SERVICE_KEY=
POS_QUOTE_HMAC_SECRET=
WEBPAY_QUOTE_HMAC_SECRET=
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
PARKFACIL_PUBLIC_BASE_URL=http://localhost:3000
PAYMENT_TOKEN_ENCRYPTION_KEY=

# SMS On Street (avisos T-15). SMS_PROVIDER=simulated no requiere el resto
# de estas variables; SMS_PROVIDER=sentraland exige todas las de abajo o
# falla explícitamente (ver src/lib/sms/sentralandClient.mjs). Ninguna
# lleva prefijo NEXT_PUBLIC_: no deben llegar nunca al navegador.
SMS_PROVIDER=simulated
SENTRALAND_INSTITUCION=
# tipo_servicio es inconsistente entre los manuales de Sentraland (ver
# docs/ auditoría) — sin valor por defecto a propósito. Debe confirmarse
# con Sentraland antes de activar SMS_PROVIDER=sentraland en un ambiente
# que envíe SMS reales.
SENTRALAND_TIPO_SERVICIO=
SENTRALAND_USUARIO=
SENTRALAND_PASSWORD=
SENTRALAND_TOKEN_URL=https://ws.sentraland.net/token/index.ams
SENTRALAND_SEND_URL=https://ws.sentraland.net/tkFinanciero/index.ams
SENTRALAND_STATUS_URL=https://ws.sentraland.net/smsstatus/index.ams
SENTRALAND_BALANCE_URL=https://ws.sentraland.net/bolsaStatus/index.ams
# Autoriza a llamar POST /api/internal/on-street-sms/process (envío) y al
# futuro job de consulta de DLR/bolsa. Mismo patrón que el CRON_SECRET ya
# usado para SMS simulado.
CRON_SECRET=

# Microsoft Graph / Office 365
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=

# Canal de entrega del correo de recuperación de contraseña
# (src/lib/passwordRecoveryCore.mjs -> resolverCanalEntregaRecuperacion).
# Valores válidos: "mailpit" | "microsoft". El proveedor del DESTINATARIO
# nunca importa (Outlook, Gmail, Yahoo, dominio corporativo, etc.) -- esta
# variable solo decide por qué canal ParkFacil ENVÍA el correo.
#   - mailpit:   usa el mailer nativo de Supabase Auth
#                (auth.resetPasswordForEmail), capturado por Mailpit del
#                stack local "supabase start". Nunca debe usarse en
#                Producción.
#   - microsoft: usa la integración real de Microsoft Graph ya configurada
#                arriba (mismo remitente, sin credenciales adicionales).
# Default si se omite: "mailpit" fuera de Producción (dev/tests); en
# Producción (NODE_ENV=production) es OBLIGATORIA y debe valer
# "microsoft" -- si falta o tiene cualquier otro valor, la solicitud falla
# de forma explícita (nunca cae en silencio a Mailpit).
# Se puede forzar "microsoft" en local (con las credenciales de arriba ya
# configuradas) para probar un envío real controlado sin dejar de usar
# Mailpit por defecto en el resto de los casos locales.
PASSWORD_RECOVERY_DELIVERY=mailpit

# Bootstrap del usuario Root (platform_admin) en Supabase LOCAL.
# Ver: npm run bootstrap:root — nunca usar contra producción.
ROOT_BOOTSTRAP_EMAIL=
ROOT_BOOTSTRAP_PASSWORD=

# Microsoft SQL Server externo (solo servidor)
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=1437
EXTERNAL_MASTER_DB_NAME=
EXTERNAL_CLIENT_DB_NAME=
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=
EXTERNAL_DB_ENCRYPT=true
EXTERNAL_DB_TRUST_SERVER_CERTIFICATE=true
